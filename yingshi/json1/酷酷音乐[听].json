let siteName = '酷酷音乐', siteKey = '', siteType = 0;
const GD_API = 'https://music-api.gdstudio.xyz/api.php';
const KUWO_HOST = 'http://wapi.kuwo.cn';

function init(cfg) {
  siteName = cfg.skey?.split('_')[1] || cfg.skey || '酷酷音乐';
  siteKey = cfg.skey;
  siteType = cfg.stype;
}

function safeJSONParse(str, defaultValue = {}) {
  if (!str || typeof str === 'object') return str || defaultValue;
  try { return JSON.parse(str); } catch { return defaultValue; }
}

async function request(url, options = {}) {
  const reqHeaders = {
    'user-agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120.0.0.0 Safari/537.36',
    ...options.headers
  };
  try {
    const response = await req(url, {
      method: options.method || 'GET',
      headers: reqHeaders,
      data: options.data,
      timeout: options.timeout || 15000
    });
    return response?.content || response?.data || response;
  } catch { return null; }
}

function sleep(seconds) {
  return new Promise(resolve => setTimeout(resolve, seconds * 1000));
}

function hd(img) {
  if (!img) return '';
  return img.replace('/120/', '/4000/').replace('/500/', '/2160/').replace('/150/', '/1000/').replace('/300/', '/1500/');
}

async function getKuwoSongUrl(rid, br) {
  const url = `https://nmobi.kuwo.cn/mobi.s?f=web&user=0&source=kwplayer_ar_4.4.2.7_B_nuoweida_vh.apk&type=convert_url_with_sign&rid=${rid}&format=flac&br=${br}`;
  const html = await request(url);
  if (html) {
    const j = safeJSONParse(html);
    return j?.data?.url?.trim() || '';
  }
  return '';
}

async function getKuwoLyric(rid) {
  for (let i = 0; i < 20; i++) {
    try {
      const url = `https://kuwo.cn/openapi/v1/www/lyric/getlyric?musicId=${rid}`;
      const html = await request(url);
      if (html) {
        const json = safeJSONParse(html);
        if (json.code === 200 && json.data?.lrclist?.length > 0) {
          return json.data.lrclist.map(item => {
            const time = parseFloat(item.time) || 0;
            const min = Math.floor(time / 60).toString().padStart(2, '0');
            const sec = Math.floor(time % 60).toString().padStart(2, '0');
            const ms = Math.floor((time % 1) * 100).toString().padStart(2, '0');
            return `[${min}:${sec}.${ms}]${item.lineLyric || ''}`;
          }).join('\n');
        }
      }
    } catch (e) {}
    if (i < 19) await sleep(0.01);
  }
  return '';
}

async function getKuwoPic(rid) {
  try {
    const picRes = await request(`http://artistpicserver.kuwo.cn/pic.web?type=rid_pic&pictype=url&size=500&rid=${rid}`);
    if (picRes) return picRes.trim().replace('/500/', '/2160/');
  } catch (e) {}
  return '';
}

async function gdGetUrl(id, br) {
  const url = `${GD_API}?types=url&id=${id}&source=kuwo&br=${br}`;
  const html = await request(url);
  if (!html) return null;
  return safeJSONParse(html);
}

