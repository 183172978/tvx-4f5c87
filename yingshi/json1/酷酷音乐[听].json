async function homeVod() {
  const url = `${KUWO_HOST}/api/pc/classify/playlist/getRcmPlayList?pn=1&rn=30&order=hot`;
  const html = await request(url);
  const res = safeJSONParse(html);
  const data = res.data?.data || [];
  const videos = data.map(it => ({
    vod_id: (it.id || '').toString(),
    vod_name: it.name || '未命名歌单',
    vod_pic: hd(it.img),
    vod_remarks: '🎧' + (it.listencnt || '0')
  }));
  return JSON.stringify({ list: videos });
}

async function category(tid, pg, filter, extend) {
  if (pg <= 0 || typeof pg == 'undefined') pg = 1;
  const id = extend?.type || tid;
  const url = `${KUWO_HOST}/api/pc/classify/playlist/getTagPlayList?pn=${pg}&rn=30&id=${id}`;
  const html = await request(url);
  const res = safeJSONParse(html);
  const data = res.data?.data || [];
  const videos = data.map(it => ({
    vod_id: (it.id || '').toString(),
    vod_name: it.name || '未命名歌单',
    vod_pic: hd(it.img),
    vod_remarks: '🎧' + (it.listencnt || '0')
  }));
  return JSON.stringify({ page: parseInt(pg), pagecount: 999, limit: 30, total: 999, list: videos });
}

async function detail(id) {
  const input = id.toString();

  if (input.indexOf('$') > -1) {
    const s = input.split('$');
    const songName = s[0] || '';
    const songId = s[1] || '';
    const picUrl = s[2] || '';
    return JSON.stringify({
      list: [{
        vod_id: songId,
        vod_name: songName,
        vod_pic: hd(picUrl),
        vod_play_from: '酷酷音乐',
        vod_play_url: songName + '$' + songId,
        vod_play_pic: hd(picUrl),
        vod_play_pic_ratio: 1.0
      }]
    });
  }

  const limit = 100;
  const baseUrl = `${KUWO_HOST}/api/www/playlist/playListInfo?pid=${input}&rn=${limit}&httpsStatus=1&pn=`;
  let html = await request(baseUrl + '1');
  let json = safeJSONParse(html);
  let data = json.data || {};
  let songs = data.musicList || data.musiclist || [];
  const total = parseInt(data.total || 0);

  if (total > limit) {
    const tasks = [];
    for (let p = 2; p <= Math.min(Math.ceil(total / limit), 5); p++) {
      tasks.push(request(baseUrl + p));
    }
    const results = await Promise.all(tasks);
    results.forEach(r => {
      const d = safeJSONParse(r).data || {};
      songs = songs.concat(d.musicList || d.musiclist || []);
    });
  }

  const playArr = [];
  const songPicArr = [];
  songs.forEach(it => {
    const rid = (it.rid || it.musicrid || '').toString().replace('MUSIC_', '');
    const song = (it.name || '').replace(/&nbsp;/g, ' ');
    const artist = (it.artist || '').replace(/&nbsp;/g, ' ');
    const albumpic = hd(it.albumpic || it.pic);
    const displayName = artist ? `${song} [${artist}]` : song;
    if (rid) {
      playArr.push(`${displayName}$${rid}&&${albumpic}&&${albumpic}`);
      songPicArr.push(albumpic);
    }
  });

  return JSON.stringify({ list: [{
    vod_id: input,
    vod_name: data.name || '酷酷歌单',
    vod_pic: hd(data.img || data.img500),
    vod_content: data.info || '',
    vod_remarks: '酷酷歌单 · ' + songs.length + '首',
    vod_play_from: '酷酷音乐',
    vod_play_url: playArr.join('#'),
    vod_play_pic: songPicArr.join('#'),
    vod_play_pic_ratio: 1.0
  }] });
}

async function play(flag, id, flags) {
  const parts = id.split('&&');
  const firstPart = parts[0] || '';
  const firstParts = firstPart.split('$');
  const songId = firstParts.length > 1 ? firstParts[1] : firstParts[0];
  let albumPic = hd(parts[1]);

  if (/\.(m3u8|mp4|m4a|mp3|aac|flac|ogg)(\?|$)/i.test(songId)) {
    return JSON.stringify({ parse: 0, url: songId.split('?')[0], pic: albumPic, cover: albumPic, lrc: '', height: 720 });
  }

  const qualities = [
    { name: 'FLAC无损', br: 2000 },
    { name: 'HQ高品质', br: 320 },
    { name: '标准品质', br: 192 },
    { name: 'AAC流畅', br: 128 }
  ];

  const urls = [];
  const seenUrls = new Set();

  for (const q of qualities) {
    try {
      const res = await gdGetUrl(songId, q.br);
      if (res?.url && !res.url.includes('.mgg') && !seenUrls.has(res.url)) {
        seenUrls.add(res.url);
        urls.push(q.name, res.url);
      }
    } catch (e) {}
  }

  const [lrc, pic] = await Promise.all([
    getKuwoLyric(songId),
    (async () => {
      if (albumPic) return albumPic;
      return await getKuwoPic(songId) || '';
    })()
  ]);

  const result = { parse: 0, url: urls, header: { 'User-Agent': 'Mozilla/5.0' }, pic: pic, cover: pic, height: 720 };
  if (lrc) result.lrc = lrc;
  return JSON.stringify(result);
}

async function search(wd, quick, pg) {
  if (pg <= 0 || typeof pg == 'undefined') pg = 1;
  const offset = (pg - 1) * 30;
  const url = `https://search.kuwo.cn/r.s?client=kt&all=${encodeURIComponent(wd)}&pn=${offset}&rn=30&vipver=1&ft=music&encoding=utf8&rformat=json&mobi=1`;
  let html = '';
  let retry = 0;
  while (!html && retry < 3) {
    html = await request(url);
    if (!html) { await sleep(0.1); retry++; }
  }
  const json = safeJSONParse((html || '').replace(/'/g, '"'));
  const videos = [];
  if (json.abslist) {
    json.abslist.forEach(it => {
      const rid = it.DC_TARGETID || it.MUSICRID?.replace('MUSIC_', '') || '';
      const pic = it.web_albumpic_short ? `http://img1.kuwo.cn/star/albumcover/${it.web_albumpic_short}` : (it.hts_MVPIC || '');
      const songName = it.SONGNAME || it.NAME || '未知歌曲';
      const artist = it.ARTIST || '未知歌手';
      videos.push({
        vod_id: `${songName} - ${artist}$${rid}$${pic}`,
        vod_name: `${songName} - ${artist}`,
        vod_pic: hd(pic),
        vod_remarks: it.ALBUM || '酷酷音乐'
      });
    });
  }
  return JSON.stringify({ page: parseInt(pg), pagecount: 999, limit: 30, total: 999, list: videos });
}

export function __jsEvalReturn() {
  return { init, home, homeVod, category, detail, play, search };
}